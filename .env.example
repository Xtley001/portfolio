# ── Admin Auth ────────────────────────────────────────────────────
# Pick any strong password. This is what you type at /admin
ADMIN_PASSWORD=your_strong_password_here

# Must be at least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=replace_with_32_char_minimum_secret_string_here

# ── GitHub (for publishing projects from admin) ───────────────────
# Create at: github.com/settings/tokens/new
# Permissions needed: repo → Contents (read + write)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=Xtley001
GITHUB_REPO=portfolio   # whatever you named your portfolio repo

# ── Cloudinary (free image hosting) ──────────────────────────────
# Sign up free at: cloudinary.com
# Cloud name: find in Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
# Create an Upload Preset at: Settings → Upload → Upload Presets
# Set it to "Unsigned" so uploads work from the browser
CLOUDINARY_UPLOAD_PRESET=portfolio_unsigned

# ── Business Growth Assessment — Email (Brevo) ────────────────────
# Get an API key at: app.brevo.com → Settings → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must be a sender verified in Brevo → Settings → Senders & IP
BREVO_FROM_EMAIL=you@yourdomain.com
BREVO_FROM_NAME=Business Growth Assessment
# Where new-lead notifications land — your inbox
LEAD_NOTIFY_EMAIL=you@yourdomain.com

# ── Business Growth Assessment — Links ─────────────────────────────
# Your booking calendar URL (Calendly, Cal.com, etc.) — used as the primary CTA
BOOKING_LINK=https://cal.com/your-handle
# Your WhatsApp number, digits only, country code, no + or spaces (e.g. 2348012345678)
# Used to build the "Message me on WhatsApp" link sent to leads
OWNER_WHATSAPP=2348012345678
